<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My App Layout</title>
    <style>
        /* Reset and layout setup */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: Arial, sans-serif;
            display: flex; /* Splits screen into left (nav) and right (content) */
            height: 100vh;
            overflow: hidden;
            background: #1e1e24;
            color: #fff;
        }

        /* PERMANENT SIDE NAV BAR */
        nav {
            width: 240px;
            background: #111116;
            display: flex;
            flex-direction: column;
            padding: 20px 10px;
            gap: 10px;
            border-right: 1px solid #333;
        }
        nav button {
            color: #aaa;
            background: none;
            border: none;
            padding: 12px;
            text-align: left;
            font-size: 16px;
            cursor: pointer;
            border-radius: 6px;
            transition: 0.2s;
        }
        nav button:hover, nav button.active-btn {
            background: #333;
            color: #fff;
        }

        /* MAIN CONTENT AREA (RIGHT SIDE) */
        .main-container {
            flex: 1;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        /* PERMANENT TOP CLOCK */
        #clock-bar {
            padding: 15px 25px;
            text-align: right;
            font-size: 14px;
            color: #888;
            font-family: monospace;
        }

        /* DYNAMIC PAGE CONTAINERS */
        .page {
            display: none;
            padding: 40px;
            flex: 1;
            overflow-y: auto;
        }
        .page.active {
            display: block; /* Only the active page wrapper displays */
        }
    </style>
</head>
<body>

    <!-- 1. PERMANENT SIDE NAV (Never unloads) -->
    <nav>
        <h2 style="padding: 10px; font-size: 20px;">Dashboard</h2>
        <button id="btn-home" class="active-btn" onclick="showPage('home')">Proxy Home</button>
        <button id="btn-games" onclick="showPage('games')">Games</button>
        <button id="btn-extras" onclick="showPage('extras')">Extras</button>
        <button id="btn-settings" onclick="showPage('settings')">Settings</button>
    </nav>

    <!-- RIGHT CONTAINER FOR CLOCK AND PAGES -->
    <div class="main-container">
        
        <!-- 2. PERMANENT CLOCK (Never unloads) -->
        <div id="clock-bar">
            Time: <span id="digital-clock">00:00:00 AM</span>
        </div>

        <!-- 3. THE DYNAMIC PAGES (Only these swap out) -->
        <div id="home" class="page active">
            <h1>Welcome to Proxy Home</h1>
            <p>Your sidebar and clock will stay exactly where they are while this content changes.</p>
        </div>

        <div id="games" class="page">
            <h1>Games Section</h1>
            <p>Game library loads right here.</p>
        </div>

        <div id="extras" class="page">
            <h1>Extras</h1>
            <p>Bonus tools and links.</p>
        </div>

        <div id="settings" class="page">
            <h1>Settings</h1>
            <p>Adjust system properties.</p>
        </div>

    </div>

    <!-- JAVASCRIPT FOR PAGE SWAPPING & LIVE CLOCK -->
    <script>
        // FUNCTION 1: SWAP CONTENT PAGES
        function showPage(pageId) {
            // Hide all pages
            document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
            // Remove active style from all nav buttons
            document.querySelectorAll('nav button').forEach(btn => btn.classList.remove('active-btn'));

            // Show current page & highlight current button
            document.getElementById(pageId).classList.add('active');
            document.getElementById('btn-' + pageId).classList.add('active-btn');
        }

        // FUNCTION 2: LIVE DIGITAL CLOCK
        function updateClock() {
            const now = new Date();
            let hours = now.getHours();
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            
            hours = hours % 12;
            hours = hours ? hours : 12; // Convert '0' hours to '12'
            hours = String(hours).padStart(2, '0');

            document.getElementById('digital-clock').textContent = `${hours}:${minutes}:${seconds} ${ampm}`;
        }

        // Run clock instantly, then update it every 1 second
        updateClock();
        setInterval(updateClock, 1000);
    </script>

</body>
</html>
